{
  "name": "inkstone",
  "version": "1.0.0",
  "description": "Inkstone - a free, open source PDF editor: view, annotate, sign, fill forms, organize pages, OCR, protect",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "vite build && electron-builder --win nsis portable",
    "dist:dir": "vite build && electron-builder --win dir"
  },
  "keywords": [
    "pdf",
    "editor",
    "annotate",
    "ocr",
    "forms"
  ],
  "author": "Inkstone contributors",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.15.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "jszip": "^3.10.2",
    "lucide": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1",
    "vite": "^6.4.5"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "org.inkstone.app",
    "productName": "Inkstone",
    "copyright": "Copyright © 2026 Inkstone contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Inkstone-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Inkstone-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Inkstone.Document",
        "description": "PDF document",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^3.4.0",
    "@signpdf/placeholder-plain": "^3.4.0",
    "@signpdf/signer-p12": "^3.4.0",
    "@signpdf/signpdf": "^3.4.0",
    "@signpdf/utils": "^3.4.0",
    "electron-updater": "^6.8.11",
    "node-forge": "^1.4.3",
    "pdf-lib": "^1.17.1"
  }
}
